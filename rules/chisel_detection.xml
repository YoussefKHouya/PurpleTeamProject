<!-- Chisel detection derived from WIN01 Sysmon Event 1 records 53885 and 53901. -->
<group name="windows,sysmon,chisel,tunneling,">
  <!--
    Build-independent behavior visibility. This does not attribute the executable to
    Chisel; it identifies client tunnel syntax from a user-writable executable path.
  -->
  <rule id="100543" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)Users.*(?:AppData.*Local.*Temp|Downloads).*\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|[[:space:]])client(?:[[:space:]]|$)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)[[:space:]](?:R:|socks(?:5)?(?:[[:space:]]|$)|[^[:space:]]+:[0-9]+:[^[:space:]]+:[0-9]+)</field>
    <description>Possible tunnel client syntax from a user-writable executable</description>
    <mitre>
      <id>T1572</id>
    </mitre>
    <group>tunnel,behavioral_visibility,user_writable_path,</group>
  </rule>

  <rule id="100525" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.hashes" type="pcre2">(?i)(?:^|,)SHA256=333E76E0F05B84035396F62990C8E84A31E23A5A43E99766F8D922C634F512E3(?:,|$)</field>
    <description>Known pinned Chisel v1.11.8 binary executed, independent of filename</description>
    <mitre>
      <id>T1572</id>
    </mitre>
    <group>process_creation,remote_services,</group>
  </rule>

  <rule id="100526" level="12">
    <if_sid>100525</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^\s*(?:\\?&quot;[^&quot;\r\n]+\\?&quot;|\S+)\s+client(?:\s|$)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)(?:R:)?(?:[^\s:]+:)?\d{1,5}:(?:[^\s:]+:)?\d{1,5}(?:\s|$)|(?:^|\s)R:socks(?:\s|$)</field>
    <description>Chisel client established explicit port-forward or reverse-tunnel syntax</description>
    <mitre>
      <id>T1572</id>
    </mitre>
    <group>process_creation,protocol_tunneling,</group>
  </rule>
</group>
