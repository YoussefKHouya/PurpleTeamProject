<!-- WinPEAS / automated Windows host-enumeration detection.
     Evidence baseline: WIN01 Security Event 4688 reaches Wazuh under native rule 67027.
     Rule 100470 detects named WinPEAS execution. Rule 100471 provides a
     rename-resistant, lower-severity behavior candidate from one discovery child.
     No frequency child is implemented: retained telemetry did not support a threshold. -->
<group name="windows,winpeas,discovery,">

  <rule id="100470" level="10">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\winpeas(?:x64|x86|any|_ofs)?\.exe$</field>
    <description>WinPEAS automated Windows privilege-escalation enumeration executed: $(win.eventdata.newProcessName)</description>
    <mitre>
      <id>T1082</id>
      <id>T1069</id>
      <id>T1083</id>
    </mitre>
    <group>winpeas_execution,host_discovery,</group>
  </rule>

  <!-- Rename-resistant candidate behavior: a user-writable executable spawning one
       discovery tool. One child is useful visibility but insufficient for escalation. -->
  <rule id="100471" level="8">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)(?:downloads|appdata|temp).*\.exe$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(?:whoami|systeminfo|tasklist|schtasks|ipconfig|net|netsh|wmic|reg)\.exe$</field>
    <description>User-writable process spawned Windows discovery binary: parent=$(win.eventdata.parentProcessName), child=$(win.eventdata.newProcessName)</description>
    <group>automated_host_enumeration_candidate,host_discovery,</group>
  </rule>


</group>
