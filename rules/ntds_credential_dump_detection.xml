<!--
  File: ntds_credential_dump_detection.xml
  Purpose: Detect execution of NTDSUtil and explicit IFM media creation
  Data source: Windows Security Event 4688
  ATT&CK: T1003.003 — NTDS
-->
<group name="windows,credential_access,ntds,">

  <!-- NTDSUtil is rare, dual-use, and high impact on a domain controller.
       This rule remains effective when commands are supplied over stdin and
       the 4688 command line contains only the executable path. -->
  <rule id="100480" level="12">
    <if_sid>67027</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\ntdsutil\.exe$</field>
    <description>Sensitive NTDSUtil execution by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName), parent $(win.eventdata.parentProcessName): $(win.eventdata.commandLine)</description>
    <mitre><id>T1003.003</id></mitre>
    <group>system_audit,ntdsutil,dual_use,</group>
  </rule>

  <!-- Explicit IFM creation is critical when arguments are visible. -->
  <rule id="100481" level="14">
    <if_sid>100480</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bactivate\s+instance\s+ntds\b[^\r\n]*\bifm\b[^\r\n]*\bcreate\s+(?:full|sysvol)\b</field>
    <description>NTDS IFM media creation command executed by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName): $(win.eventdata.commandLine)</description>
    <mitre><id>T1003.003</id></mitre>
    <group>credential_dumping,ntds_ifm,critical,</group>
  </rule>

</group>
