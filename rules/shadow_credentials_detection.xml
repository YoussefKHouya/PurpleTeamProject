<group name="windows,active_directory,shadow_credentials,">

  <!-- Wazuh native rule 60229 covers Security 5136. -->

  <!-- High-confidence Shadow Credentials persistence: KeyCredential value added. -->
  <rule id="100451" level="15">
    <if_sid>60229</if_sid>
    <field name="win.eventdata.attributeLDAPDisplayName">^msDS-KeyCredentialLink$</field>
    <field name="win.eventdata.operationType">^%%14674$</field>
    <description>Shadow Credentials: msDS-KeyCredentialLink value added by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098.005</id>
    </mitre>
    <group>shadow_credentials,account_manipulation,authentication_processes,high_confidence,</group>
  </rule>

  <!-- Removal/restoration is lower severity but critical correlation evidence. -->
  <rule id="100452" level="5">
    <if_sid>60229</if_sid>
    <field name="win.eventdata.attributeLDAPDisplayName">^msDS-KeyCredentialLink$</field>
    <field name="win.eventdata.operationType">^%%14675$</field>
    <description>Shadow Credentials cleanup: msDS-KeyCredentialLink value deleted by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098.005</id>
    </mitre>
    <group>shadow_credentials,account_manipulation,cleanup,</group>
  </rule>

</group>
