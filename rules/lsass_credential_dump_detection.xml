<!--
  File: lsass_credential_dump_detection.xml
  Purpose: Detect LSASS memory access and dump creation on the Windows workstation
  Data sources: Sysmon 7/10/11 and Windows Security 4688
  ATT&CK: T1003.001 — LSASS Memory
-->
<group name="windows,sysmon,credential_access,lsass_memory,">

  <!-- High-confidence known dump-capable process accessing LSASS. -->
  <rule id="100420" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)\\(?:rundll32|procdump(?:64)?|taskmgr|rdrleakdiag|createdump|dumpert|nanodump|mimikatz)\.exe$</field>
    <description>High-confidence LSASS access by dump-capable process: $(win.eventdata.sourceImage), access $(win.eventdata.grantedAccess), user $(win.eventdata.sourceUser)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_dumping,lsass_access,high_confidence,</group>
  </rule>

  <!-- Suspicious memory-read/all-access masks from an otherwise unknown process. -->
  <rule id="100421" level="10">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(?:1fffff|1f3fff|1f0fff|143a|1410|1010|1038|40|10)$</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)^(?:C:\\Windows\\system32\\wbem\\wmiprvse\.exe|C:\\Windows\\system32\\(?:wininit|csrss|svchost)\.exe|C:\\ProgramData\\Microsoft\\Windows Defender\\platform\\[^\\]+\\MsMpEng\.exe|C:\\Program Files \(x86\)\\ossec-agent\\wazuh-agent\.exe)$</field>
    <description>Suspicious process memory access to LSASS: $(win.eventdata.sourceImage), access $(win.eventdata.grantedAccess), user $(win.eventdata.sourceUser)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_dumping,lsass_access,suspicious_access_mask,</group>
  </rule>

  <!-- Correct built-in rule 92900 substring matching: 0x101000 is not 0x1010. -->
  <rule id="100426" level="0">
    <if_sid>92900</if_sid>
    <field name="win.eventdata.grantedAccess">^0x101000$</field>
    <description>Suppress false positive: LSASS access 0x101000 was substring-matched by rule 92900</description>
    <group>lsass_access,false_positive_suppression,</group>
  </rule>

  <!-- Suppress exact known-benign 0x1010/0x40 LSASS readers selected by rule 92900. -->
  <rule id="100427" level="0">
    <if_sid>92900</if_sid>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(?:1010|40)$</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)^(?:C:\\Windows\\system32\\svchost\.exe|C:\\ProgramData\\Microsoft\\Windows Defender\\platform\\[^\\]+\\MsMpEng\.exe)$</field>
    <description>Suppress known-benign LSASS reader selected by rule 92900: $(win.eventdata.sourceImage)</description>
    <group>lsass_access,false_positive_suppression,</group>
  </rule>

  <!-- Dump-like file created. -->
  <rule id="100423" level="12">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(?:\\[^\\]*lsass[^\\]*\.(?:dmp|dump|bin)$|\.(?:dmp|dump)$)</field>
    <description>Possible LSASS dump file created: $(win.eventdata.targetFilename) by $(win.eventdata.image), user $(win.eventdata.user)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_dumping,lsass_dump_file,high_confidence,</group>
  </rule>

  <!-- comsvcs.dll loaded by rundll32.exe. -->
  <rule id="100424" level="10">
    <if_sid>61609</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)\\comsvcs\.dll$</field>
    <description>Rundll32 loaded comsvcs.dll, possible MiniDump abuse: $(win.eventdata.image), user $(win.eventdata.user)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_dumping,comsvcs_minidump,</group>
  </rule>

  <!-- Direct process-command detection independent of cmd.exe wrapper rules. -->
  <rule id="100425" level="13">
    <if_sid>67027</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:comsvcs\.dll[^\r\n]*\bMiniDump\b|procdump(?:64)?(?:\.exe)?[^\r\n]*(?:-ma\s+)?lsass(?:\.exe)?|mimikatz(?:\.exe)?|sekurlsa::)</field>
    <description>LSASS credential-dumping command executed by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName): $(win.eventdata.commandLine)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_dumping,lsass_command,high_confidence,</group>
  </rule>

</group>
