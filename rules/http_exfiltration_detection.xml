<!-- Layered HTTP/S upload-attempt detection derived from live WIN01 Security 4688, Sysmon Event 1, and PowerShell 4104 telemetry. -->
<group name="windows,http_exfiltration,exfiltration,">
  <!-- Follow-up: tighten curl next-transfer option handling to a complete token; paths containing the option text as a substring need dedicated coverage. -->
  <!-- Curl upload syntax and an HTTP/S URL must occur in the same transfer segment; transfer resets are hard boundaries. -->
  <rule id="100530" level="10">
    <if_sid>92031,67027</if_sid>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\curl\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\\?&quot;|@\S+)|--upload-file(?:=|\s+)(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)|-T\s+(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+))(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:\\?&quot;)?https?://\S+|(?:\\?&quot;)?https?://\S+(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\\?&quot;|@\S+)|--upload-file(?:=|\s+)(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)|-T\s+(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)))</field>
    <description>curl local-file upload attempt syntax bound to an HTTP/S transfer segment</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>data_exfiltration,http_upload,curl,upload_attempt,</group>
  </rule>

  <!-- Sensitive source must itself be the upload argument in the same HTTP/S curl transfer segment. -->
  <rule id="100531" level="12">
    <if_sid>100530</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$))|--upload-file(?:=|\s+)(?:\\?&quot;@?[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@?\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$))|-T\s+(?:\\?&quot;@?[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@?\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$)))(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:\\?&quot;)?https?://\S+|(?:\\?&quot;)?https?://\S+(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$))|--upload-file(?:=|\s+)(?:\\?&quot;@?[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@?\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$))|-T\s+(?:\\?&quot;@?[^&quot;\r\n]+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)\\?&quot;|@?\S+\.(?:txt|csv|tsv|zip|7z|rar|kdbx|pst|ost|bak|db|sqlite|doc|docx|xls|xlsx|pdf|pem|pfx|p12|key|config|env)(?=\s|$))))</field>
    <description>curl sensitive local-file source bound to an HTTP/S upload transfer segment</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>data_exfiltration,http_upload,sensitive_file,upload_attempt,</group>
  </rule>

  <!-- Each API alternative binds the HTTP/S destination to the same upload call or command segment. -->
  <rule id="100532" level="10">
    <if_sid>91816</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?is)(?:\bcurl(?:\.exe)?\b(?:(?!&amp;&amp;|\|\|?)[^;\r\n])*?(?:(?:--data-binary(?:=|\s+)[^;\s]{0,4}@|--upload-file(?:=|\s+)(?![^;\s]{0,4}https?://)|-T\s+(?![^;\s]{0,4}https?://))(?:(?!--next|&amp;&amp;|\|\|?)[^;\r\n])*?[^;\s]{0,4}https?://|[^;\s]{0,4}https?://(?:(?!--next|&amp;&amp;|\|\|?)[^;\r\n])*?(?:--data-binary(?:=|\s+)[^;\s]{0,4}@|--upload-file(?:=|\s+)(?![^;\s]{0,4}https?://)|-T\s+(?![^;\s]{0,4}https?://)))|\b(?:Invoke-WebRequest|Invoke-RestMethod|iwr|irm)\b(?=[^;\r\n]{0,1000}\s-InFile(?:\s|:))(?=[^;\r\n]{0,1000}\s-Uri(?:\s|:)[^;\r\n]{0,8}https?://)[^;\r\n]{0,1000}|\bUpload(?:File|Data)\s*\(\s*[^;\r\n]{0,4}https?://|\bStart-BitsTransfer\b(?=[^;\r\n]{0,1000}\s-TransferType\s+Upload\b)(?=[^;\r\n]{0,1000}\s-Destination\s+[^;\r\n]{0,8}https?://)[^;\r\n]{0,1000}|(?:StreamContent|ByteArrayContent)[\s\S]{0,500}\b(?:PostAsync|PutAsync)\s*\(\s*[^;\r\n]{0,4}https?://)</field>
    <description>PowerShell script block contains upload API indicators bound to a literal HTTP/S destination</description>
    <mitre>
      <id>T1041</id>
      <id>T1059.001</id>
    </mitre>
    <group>data_exfiltration,http_upload,powershell,upload_attempt,</group>
  </rule>

  <!-- Rename-resistant curl attribution through Sysmon PE OriginalFileName metadata. -->
  <rule id="100544" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^curl\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\\?&quot;|@\S+)|--upload-file(?:=|\s+)(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)|-T\s+(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+))(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:\\?&quot;)?https?://\S+|(?:\\?&quot;)?https?://\S+(?:(?!\s--next(?:\s|$))[^\r\n;])*?(?:--data-binary(?:=|\s+)(?:\\?&quot;@[^&quot;\r\n]+\\?&quot;|@\S+)|--upload-file(?:=|\s+)(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)|-T\s+(?!(?:\\?&quot;)?https?://)(?:\\?&quot;@?[^&quot;\r\n]+\\?&quot;|@?\S+)))</field>
    <description>curl OriginalFileName metadata with local-file upload syntax bound to an HTTP/S transfer segment</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>data_exfiltration,http_upload,curl_metadata,upload_attempt,</group>
  </rule>

  <!-- Co-occurrence, not dataflow proof: credential-like staging and an HTTP/S upload call share one script block. -->
  <rule id="100545" level="11">
    <if_sid>100532</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?is)(?:\bWriteAllLines\b|\bWriteAllText\b|\bSet-Content\b)[\s\S]{0,2000}(?:password|recoverytoken|api[_-]?key|secret|credential|token)\s*=</field>
    <description>Credential-like text staging co-occurs with an HTTP/S upload call in one PowerShell script block</description>
    <mitre>
      <id>T1005</id>
      <id>T1041</id>
      <id>T1059.001</id>
    </mitre>
    <group>credential_staging,http_upload,powershell,combined_behavior,</group>
  </rule>

  <!-- Parallel base-parent path for script blocks that do not select built-in environment-variable child 91816. -->
  <rule id="100547" level="10">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?is)(?:\bcurl(?:\.exe)?\b(?:(?!&amp;&amp;|\|\|?)[^;\r\n])*?(?:(?:--data-binary(?:=|\s+)[^;\s]{0,4}@|--upload-file(?:=|\s+)(?![^;\s]{0,4}https?://)|-T\s+(?![^;\s]{0,4}https?://))(?:(?!--next|&amp;&amp;|\|\|?)[^;\r\n])*?[^;\s]{0,4}https?://|[^;\s]{0,4}https?://(?:(?!--next|&amp;&amp;|\|\|?)[^;\r\n])*?(?:--data-binary(?:=|\s+)[^;\s]{0,4}@|--upload-file(?:=|\s+)(?![^;\s]{0,4}https?://)|-T\s+(?![^;\s]{0,4}https?://)))|\b(?:Invoke-WebRequest|Invoke-RestMethod|iwr|irm)\b(?=[^;\r\n]{0,1000}\s-InFile(?:\s|:))(?=[^;\r\n]{0,1000}\s-Uri(?:\s|:)[^;\r\n]{0,8}https?://)[^;\r\n]{0,1000}|\bUpload(?:File|Data)\s*\(\s*[^;\r\n]{0,4}https?://|\bStart-BitsTransfer\b(?=[^;\r\n]{0,1000}\s-TransferType\s+Upload\b)(?=[^;\r\n]{0,1000}\s-Destination\s+[^;\r\n]{0,8}https?://)[^;\r\n]{0,1000}|(?:StreamContent|ByteArrayContent)[\s\S]{0,500}\b(?:PostAsync|PutAsync)\s*\(\s*[^;\r\n]{0,4}https?://)</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2" negate="yes">(?i)(\$env\:TEMP|\$env\:USERNAME|\$env\:COMPUTERNAME|\$env\:USERDOMAIN|\$PID)</field>
    <description>PowerShell base-parent script block contains upload API indicators bound to a literal HTTP/S destination</description>
    <mitre>
      <id>T1041</id>
      <id>T1059.001</id>
    </mitre>
    <group>data_exfiltration,http_upload,powershell,upload_attempt,base_parent_path,</group>
  </rule>

  <rule id="100548" level="11">
    <if_sid>100547</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?is)(?:\bWriteAllLines\b|\bWriteAllText\b|\bSet-Content\b)[\s\S]{0,2000}(?:password|recoverytoken|api[_-]?key|secret|credential|token)\s*=</field>
    <description>Credential-like text staging on the PowerShell base-parent path co-occurs with an HTTP/S upload call in one PowerShell script block</description>
    <mitre>
      <id>T1005</id>
      <id>T1041</id>
      <id>T1059.001</id>
    </mitre>
    <group>credential_staging,http_upload,powershell,combined_behavior,base_parent_path,</group>
  </rule>
</group>
