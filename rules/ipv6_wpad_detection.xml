<group name="windows,network,ipv6,wpad,">

  <!-- DHCPv6 client configuration event observed on WIN01. -->
  <rule id="100460" level="3">
    <if_sid>60009</if_sid>
    <field name="win.system.providerName">^Microsoft-Windows-Dhcp-Client$</field>
    <field name="win.system.eventID">^50093$</field>
    <field name="win.system.channel">^Microsoft-Windows-Dhcp-Client/Operational$</field>
    <description>DHCPv6 client configuration activity on $(win.system.computer)</description>
    <group>ipv6,dhcpv6,configuration_change,</group>
  </rule>

  <!-- Domain-independent WPAD hostname lookup; visibility, not proof of poisoning.
       Accept a bare hostname or DNS suffix, case-insensitively, with an optional root dot. -->
  <rule id="100461" level="10">
    <if_sid>60009</if_sid>
    <field name="win.system.providerName">^Microsoft-Windows-DNS-Client$</field>
    <field name="win.system.eventID">^3020$</field>
    <field name="win.system.channel">^Microsoft-Windows-DNS-Client/Operational$</field>
    <field name="win.eventdata.queryName" type="pcre2">(?i)^wpad(?:\.[a-z0-9_-]+)*\.?(?![\s\S])</field>
    <description>WPAD DNS lookup: $(win.eventdata.queryName) on $(win.system.computer)</description>
    <mitre>
      <id>T1557</id>
    </mitre>
    <group>ipv6,wpad,dns_query,adversary_in_the_middle,</group>
  </rule>

</group>
