<group name="windows,mssql,xp_cmdshell,">

  <!-- SQL Server Application event: xp_cmdshell configuration changed. -->
  <rule id="100539" level="5">
    <if_sid>60600</if_sid>
    <field name="win.system.eventID">^15457$</field>
    <field name="win.system.providerName" type="pcre2">(?i)^MSSQL(?:\$[A-Za-z0-9_.-]+)?$</field>
    <field name="win.system.message" type="pcre2">(?i)Configuration option ['\"]xp_cmdshell['\"] changed from [0-9]+ to [0-9]+</field>
    <description>Microsoft SQL Server xp_cmdshell configuration state changed: $(win.system.message)</description>
    <mitre>
      <id>T1505.001</id>
    </mitre>
    <group>mssql_configuration_change,database_extended_stored_procedure,</group>
  </rule>

  <!-- High-risk transition: xp_cmdshell enabled. -->
  <rule id="100540" level="12">
    <if_sid>100539</if_sid>
    <field name="win.system.message" type="pcre2">(?i)Configuration option ['\"]xp_cmdshell['\"] changed from 0 to 1</field>
    <description>Microsoft SQL Server xp_cmdshell was enabled</description>
    <mitre>
      <id>T1505.001</id>
    </mitre>
    <group>mssql_xp_cmdshell_enabled,database_extended_stored_procedure,</group>
  </rule>

  <!-- Live-proven xp_cmdshell process shape: sqlservr.exe -> cmd.exe /c ... -->
  <rule id="100541" level="13">
    <if_sid>100300</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)(?:^|[\\]+)sqlservr\.exe$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)(?:^|[\\]+)cmd\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|[\s\"])/c(?:\s|$)</field>
    <description>SQL Server spawned cmd.exe with /c, consistent with xp_cmdshell OS command execution: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1505.001</id>
      <id>T1059.003</id>
    </mitre>
    <group>mssql_xp_cmdshell_execution,windows_command_shell,</group>
  </rule>

</group>
