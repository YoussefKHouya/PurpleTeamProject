<!--
  Seatbelt generic metadata visibility plus bounded host-recon classification.
  Derived from WIN01 Sysmon Event 1 record 51067 on 2026-08-06.
  OriginalFileName/Product survive ordinary executable renaming.
-->
<group name="windows,sysmon,seatbelt,tool_execution,">
  <!-- Rename-resistant generic visibility from authentic PE metadata. -->
  <rule id="100542" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^Seatbelt\.exe$</field>
    <field name="win.eventdata.product" type="pcre2">(?i)^Seatbelt$</field>
    <description>Seatbelt executable metadata detected (module-independent visibility)</description>
    <group>seatbelt,tool_metadata,rename_resistant,</group>
  </rule>
</group>

<group name="windows,sysmon,seatbelt,discovery,">
  <rule id="100524" level="12">
    <if_sid>100542</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^\s*(?:\\?&quot;[^&quot;\r\n]+\\?&quot;|\S+)\s+OSInfo\s+TokenGroups\s+PowerShell\s*$</field>
    <description>Seatbelt performed bounded host reconnaissance for OS, token groups, and PowerShell posture</description>
    <mitre>
      <id>T1082</id>
      <id>T1069.002</id>
    </mitre>
    <group>process_creation,host_discovery,permission_groups_discovery,</group>
  </rule>
</group>
