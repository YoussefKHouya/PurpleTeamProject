<group name="windows,kerberos,asrep_roasting,">

  <!-- Restore successful Event 4768 visibility from the level-0 audit-success parent. -->
  <rule id="100410" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.status">^0x0$</field>
    <description>Kerberos TGT requested for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <group>kerberos_tgt_request,authentication_success,</group>
  </rule>

  <!-- Successful TGT request without pre-authentication for a non-machine account. -->
  <rule id="100411" level="10">
    <if_sid>100410</if_sid>
    <field name="win.eventdata.preAuthType">^0$</field>
    <field name="win.eventdata.targetUserName" type="pcre2" negate="yes">(?i)(?:\$$|^krbtgt$)</field>
    <description>Possible AS-REP Roasting: pre-authentication-free AS-REP issued for $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>asrep_roasting,credential_access,authentication_success,</group>
  </rule>

  <!-- Treat any execution of the Rubeus credential-access tool as malicious. -->
  <rule id="100412" level="12">
    <if_sid>67027</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\rubeus\.exe$</field>
    <description>Rubeus credential-access tool executed by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName) on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <group>rubeus,credential_access,attack_tool,process_creation,</group>
  </rule>

  <!-- Detect DC/Kerberos credential-access Rubeus verbs when executable is renamed. -->
  <rule id="100413" level="13">
    <if_sid>67027</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|[\s\"'])(?:asktgt|kerberoast|asreproast(?:ing)?)(?=\s|/|$)</field>
    <description>Possible renamed Rubeus Kerberos credential-access command executed by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName) on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <group>rubeus,credential_access,attack_tool,process_creation,</group>
  </rule>


</group>
